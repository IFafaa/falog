---
// Stable builds for each system (fixed asset names on the latest release), the Linux one-liner, and
// the newest preview when there is one. Versions come from the data read when the site was built
// (lib/releases.ts); app.js only marks the visitor's system.
import Icon from "./Icon.astro";
import { COPY, pageUrl, type Lang } from "../i18n";
import { formatDate } from "../lib/dates";
import { LATEST_DOWNLOAD, hasAsset, releases } from "../lib/releases";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = COPY[lang].download;
const r = COPY[lang].releases;
const { stable, preview } = releases;
const noRelease = releases.known && !stable;

// A file missing from the latest release would 404: link its release page instead.
const link = (file: string) =>
  hasAsset(file)
    ? { href: LATEST_DOWNLOAD + file }
    : { href: stable!.url, title: d.missingAsset.replace("{version}", stable!.tag) };
---

<section class="section page-top" aria-labelledby="download-title">
  <div class="wrap">
    <header class="section-head">
      <p class="label mono">{d.label}</p>
      <h1 id="download-title">{d.title}</h1>
      <p class="section-lede mono">
        {
          stable ? (
            <>
              <span class="badge stable">{r.stable}</span> {stable.tag} · {formatDate(stable.published, lang)} ·{" "}
              <a href={stable.url}>{d.notesLink}</a>
            </>
          ) : noRelease ? (
            d.stableNone
          ) : (
            d.stableDefault
          )
        }
      </p>
    </header>

    {noRelease && <p class="notice" set:html={d.noRelease} />}

    {
      !noRelease && (
        <div class="platforms" data-your-system={d.yourSystem}>
          <article class="platform" id="os-windows">
            <h2>Windows</h2>
            <p class="platform-sub mono">{d.windows.sub}</p>
            <div class="platform-actions">
              <a class="btn primary dl" {...link("Falog-Setup-x64.exe")}>
                <Icon name="download" />
                {d.windows.button}
              </a>
            </div>
            <p class="platform-note" set:html={d.windows.note} />
          </article>

          <article class="platform" id="os-macos">
            <h2>macOS</h2>
            <p class="platform-sub mono">{d.macos.sub}</p>
            <div class="platform-actions">
              <a class="btn primary dl" id="mac-arm" {...link("Falog-macOS-arm64.dmg")}>
                <Icon name="download" />
                {d.macos.arm}
              </a>
              <a class="btn ghost dl" id="mac-intel" {...link("Falog-macOS-x64.dmg")}>
                {d.macos.intel}
              </a>
            </div>
            <p class="platform-note" set:html={d.macos.note} />
          </article>

          <article class="platform" id="os-linux">
            <h2>Linux</h2>
            <p class="platform-sub mono">{d.linux.sub}</p>
            {hasAsset("install.sh") && (
              <div class="terminal">
                <code id="install-cmd">curl -fsSL {LATEST_DOWNLOAD}install.sh | sh</code>
                <button class="icon-btn copy" type="button" data-copy="install-cmd" aria-label={d.linux.copy} title={d.linux.copy}>
                  <Icon name="copy" class="i-copy" />
                  <Icon name="check" class="i-check" />
                </button>
              </div>
            )}
            <div class="platform-actions">
              <a class="btn ghost dl" {...link("falog-linux-x86_64.tar.gz")}>
                <Icon name="download" />
                {d.linux.button}
              </a>
            </div>
            <p class="platform-note">{d.linux.note}</p>
          </article>
        </div>
      )
    }

    <p class="download-foot">{d.agents}</p>

    {
      preview && (
        <section class="preview" aria-labelledby="preview-title">
          <h2 id="preview-title">
            <span class="badge preview-badge">{d.previewBadge}</span>{" "}
            <span class="mono">
              {preview.tag} · {formatDate(preview.published, lang)}
            </span>
          </h2>
          <p>{d.previewText}</p>
          <ul class="preview-assets">
            {preview.assets.map((asset) => (
              <li>
                <a href={asset.url}>{asset.name}</a>
              </li>
            ))}
            <li>
              <a href={preview.url}>{d.previewPage}</a>
            </li>
          </ul>
        </section>
      )
    }

    <p class="download-foot" set:html={d.older.replace("{releases}", pageUrl(lang, "releases"))} />
  </div>
</section>
