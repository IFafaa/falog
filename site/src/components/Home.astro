---
// The overview: what Falog is, its views and features, and a look at its progress.
import Icon from "./Icon.astro";
import Shot from "./Shot.astro";
import Code from "./Code.astro";
import { COPY, pageUrl, type Lang } from "../i18n";
import { roadmap, type RoadmapTask } from "../lib/roadmap";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = COPY[lang];
const h = t.home;
const tr = (text: string) => t.roadmap[text] ?? text;
// Roadmap text with no Portuguese entry stays English; say so to screen readers.
const textLang = (text: string) => (lang === "en" || t.roadmap[text] ? undefined : "en");

// Engineering work on the roadmap that changes nothing a person using Falog sees.
const BEHIND_THE_SCENES = new Set(["0013", "0016", "0018"]);
const SHIPPED_SHOWN = 5;
const visible = roadmap.tasks.filter((task) => !BEHIND_THE_SCENES.has(task.num));
const next = visible.filter((task) => task.stage === "next");
const shipped = visible.filter((task) => task.stage === "done").reverse();
// Work in progress is not shown: the page lists what is next and what shipped.
const groups: { stage: "next" | "done"; items: RoadmapTask[]; why: boolean }[] = [
  { stage: "next", items: next, why: true },
  { stage: "done", items: shipped.slice(0, SHIPPED_SHOWN), why: false },
];
---

<section class="hero" id="top">
  <div class="wrap">
    <h1 set:html={h.title} />
    <p class="lede">{h.lede}</p>
    <div class="cta">
      <a class="btn primary" id="hero-download" href={pageUrl(lang, "download")}>
        <Icon name="download" />
        <span id="hero-download-label">{h.download}</span>
        <span class="btn-meta mono" id="hero-download-meta"></span>
      </a>
      <a class="btn ghost" href="#features">{h.tour}</a>
    </div>
    <p class="also mono" id="hero-also">{h.also}<a href={pageUrl(lang, "download")}>{h.allDownloads}</a></p>
    <Shot name="hero" alt={h.heroAlt} class="hero-shot" eager />
  </div>
</section>

<section class="section" id="features" aria-labelledby="features-title">
  <div class="wrap">
    <header class="section-head">
      <p class="label mono">{h.featuresLabel}</p>
      <h2 id="features-title">{h.featuresTitle}</h2>
      <p class="section-lede">{h.featuresLede}</p>
    </header>

    <div class="views">
      <div class="tabs" role="tablist" aria-label={h.viewsLabel}>
        {
          h.views.map((view, i) => (
            <button
              role="tab"
              id={`tab-${view.id}`}
              aria-controls={`view-${view.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? undefined : "-1"}
            >
              {view.name}
            </button>
          ))
        }
      </div>
      {
        h.views.map((view, i) => (
          <div class="view" role="tabpanel" id={`view-${view.id}`} aria-labelledby={`tab-${view.id}`} hidden={i > 0}>
            <p class="view-caption" set:html={view.caption} />
            <Shot
              name={view.id}
              alt={{ dark: h.themeAlt.dark + view.alt, light: h.themeAlt.light + view.alt }}
            />
          </div>
        ))
      }
    </div>

    <ul class="grid" aria-label={h.featuresList}>
      {
        h.features.map((feature) => (
          <li class="cell">
            <Icon name={feature.icon} class="cell-icon" />
            <h3>{feature.title}</h3>
            <p set:html={feature.text} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section" id="progress" aria-labelledby="progress-title">
  <div class="wrap">
    <header class="section-head">
      <p class="label mono">{h.progressLabel}</p>
      <h2 id="progress-title">{h.progressTitle}</h2>
      <p class="section-lede" set:html={h.progressLede} />
    </header>

    <div class="progress">
      <div class="column">
        <h3 class="column-title">{h.latestTitle}</h3>
        <div id="latest-release" aria-live="polite">
          <p class="muted">{h.latestLoading}</p>
        </div>
        <a class="more mono" href={pageUrl(lang, "releases")}>{h.allReleases} →</a>
      </div>

      <div class="column" id="roadmap">
        <h3 class="column-title">{h.roadmapTitle}</h3>
        {
          groups.map(
            (group) =>
              group.items.length > 0 && (
                <div class={`roadmap-group ${group.stage}`}>
                  <h4>{h.stages[group.stage]}</h4>
                  <ul>
                    {group.items.map((task) => (
                      <li>
                        <span lang={textLang(task.title)}>
                          <Code text={tr(task.title)} />
                        </span>
                        {group.why && (
                          <span class="roadmap-why" lang={textLang(task.why)}>
                            <Code text={tr(task.why)} />
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                  {group.stage === "done" && shipped.length > SHIPPED_SHOWN && (
                    <p class="roadmap-more muted">{h.moreShipped(shipped.length - SHIPPED_SHOWN)}</p>
                  )}
                </div>
              ),
          )
        }
        <a class="more mono" href="https://github.com/IFafaa/falog/blob/main/.spec/roadmap.md">{h.roadmapLink}</a>
      </div>
    </div>
  </div>
</section>
