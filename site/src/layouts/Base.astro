---
// Every page: head (meta, alternates in each language, Content Security Policy), header with the
// page links, language and theme switches, the one-time language suggestion, and the footer.
import "../styles/global.css";
import iconSvg from "../../../crates/falog-desktop/assets/icon/falog.svg?url";
import iconPng from "../../../crates/falog-desktop/assets/icon/png/falog-256.png?url";
import plexRegular from "../../../crates/falog-desktop/assets/fonts/IBMPlexSans-Regular.ttf?url";
import plexSemiBold from "../../../crates/falog-desktop/assets/fonts/IBMPlexSans-SemiBold.ttf?url";
import Icon from "../components/Icon.astro";
import { COPY, LANGS, REPO, asset, otherLang, pageUrl, type Lang, type Page } from "../i18n";

interface Props {
  lang: Lang;
  page: Page;
}
const { lang, page } = Astro.props;
const t = COPY[lang];
const other = otherLang(lang);
const meta = t.meta[page];
const absolute = (path: string) => new URL(path, Astro.site).href;
const ogImage = absolute(asset("img/hero-dark.webp"));
const pages: Page[] = ["home", "download", "releases"];
// Only script-free policies: theme.js and app.js are files, and the strings below are JSON data.
const csp =
  "default-src 'self'; connect-src https://api.github.com; img-src 'self' data:; base-uri 'none'; form-action 'none'; object-src 'none'";
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={absolute(pageUrl(lang, page))} />
    {LANGS.map((l) => <link rel="alternate" hreflang={COPY[l].htmlLang} href={absolute(pageUrl(l, page))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(pageUrl("en", page))} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#282c33" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={absolute(pageUrl(lang, page))} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === "pt" ? "pt_BR" : "en_US"} />
    <link rel="icon" href={iconSvg} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={iconPng} />
    <link rel="preload" href={plexRegular} as="font" type="font/ttf" crossorigin />
    <link rel="preload" href={plexSemiBold} as="font" type="font/ttf" crossorigin />
    <!-- Sets the theme before the first paint, so a light-mode visitor never sees a dark flash. -->
    <script is:inline src={asset("theme.js")}></script>
    <script is:inline src={asset("app.js")} defer></script>
    <script is:inline type="application/json" id="strings" set:html={JSON.stringify(t.js)} />
  </head>
  <body data-page={page} data-releases-url={pageUrl(lang, "releases")} data-download-url={pageUrl(lang, "download")}>
    <a class="skip" href="#main">{t.nav.skip}</a>

    <aside class="lang-suggest" id="lang-suggest" lang={COPY[other].htmlLang} hidden>
      <div class="wrap lang-suggest-inner">
        <Icon name="globe" class="lang-suggest-icon" />
        <p>{COPY[other].suggest.text}</p>
        <a class="btn primary small" href={pageUrl(other, page)} data-lang-choice={other}>{COPY[other].suggest.action}</a>
        <button class="btn ghost small" type="button" id="lang-suggest-dismiss">{COPY[other].suggest.dismiss}</button>
      </div>
    </aside>

    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href={pageUrl(lang, "home")} aria-label={t.nav.brandHome}>
          <img src={iconSvg} width="24" height="24" alt="" />
          <span>Falog</span>
        </a>
        <nav aria-label={t.nav.sections}>
          <ul class="nav-links">
            {
              pages.map((p) => (
                <li>
                  <a href={pageUrl(lang, p)} aria-current={p === page ? "page" : undefined}>
                    {t.nav[p]}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="nav-end">
          <a class="nav-github" href={REPO}>{t.nav.github}</a>
          <a
            class="lang-switch"
            href={pageUrl(other, page)}
            hreflang={COPY[other].htmlLang}
            lang={COPY[other].htmlLang}
            data-lang-choice={other}
            title={t.nav.switchLanguage}
            aria-label={t.nav.switchLanguage}
          >
            <Icon name="globe" />
            <span>{other.toUpperCase()}</span>
          </a>
          <button class="icon-btn" id="theme-toggle" type="button" aria-label={t.nav.themeToLight} title={t.nav.themeToLight}>
            <Icon name="sun" class="i-sun" />
            <Icon name="moon" class="i-moon" />
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <p class="brand-small"><img src={iconSvg} width="18" height="18" alt="" /> Falog · {t.footer.license}</p>
        <ul class="footer-links mono">
          <li><a href={REPO}>{t.footer.source}</a></li>
          <li><a href={`${REPO}/releases`}>{t.footer.releases}</a></li>
          <li><a href={`${REPO}/issues`}>{t.footer.issues}</a></li>
          <li><a href={`${REPO}/tree/main/.spec`}>{t.footer.specs}</a></li>
        </ul>
        <p class="credits">{t.footer.credits}</p>
      </div>
    </footer>
  </body>
</html>
